# Plantilla SIN valores reales. Copia a .env.local (excluido de Git) y rellena.
# Los valores reales se custodian en Bitwarden y, para Vercel, se configuran en
# Project → Settings → Environment Variables (valores distintos por entorno).

# Cadena de conexión PostgreSQL de la CUENTA DE LA APLICACIÓN (app_riesgos),
# nunca la administradora. Uso: lib/db.ts (solo servidor).
# Sustitución: genera nueva contraseña del rol en el proveedor y actualiza aquí y en Vercel.
DATABASE_URL=

# Cadena de conexión de la CUENTA ADMINISTRADORA (admin_migraciones).
# Solo se usa en local para aplicar migraciones (psql "$DATABASE_URL_ADMIN" -f db/001_crear_riesgos.sql).
# NO se configura en Vercel ni en ningún entorno de producción o Preview.
DATABASE_URL_ADMIN=

# Hash scrypt de la contraseña del perfil «gestor» (formato scrypt:<sal>:<hash>,
# sin signos «$», que Next.js interpretaría como variables).
# Se genera con: node scripts/hash-password.mjs   Uso: lib/auth.ts (solo servidor).
# Sustitución: genera un hash nuevo y reemplázalo; las sesiones antiguas siguen hasta caducar
# salvo que cambies también SESSION_SECRET.
ADMIN_PASSWORD_HASH=

# Secreto para firmar la cookie de sesión (mínimo 32 caracteres).
# Se genera con: node scripts/session-secret.mjs   Uso: lib/auth.ts (solo servidor).
# Sustitución: cambiarlo invalida todas las sesiones abiertas.
SESSION_SECRET=
